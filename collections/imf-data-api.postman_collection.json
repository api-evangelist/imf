  "item": [
    {
      "id": "4d7267e6-a91c-4633-be4a-00c0c50b6ef4",
      "name": "Data",
      "description": {
        "content": "Retrieve actual statistical data observations from IMF datasets",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "e138880a-a051-4987-a067-7ce191557a93",
          "name": "Retrieve data observations from an IMF dataset",
          "request": {
            "name": "Retrieve data observations from an IMF dataset",
            "description": {
              "content": "Returns time-series data observations for the specified dataflow filtered\nby the dimension key. The key is a dot-separated string where each position\ncorresponds to a dimension in the dataset's data structure definition (DSD),\nin positional order. Use '+' to specify multiple values for a dimension and\n'*' or blank to wildcard a dimension.\n\nExamples:\n- `A.USA.PCPI` - Annual, USA, Consumer Price Index\n- `A+Q.USA+GBR.*` - Annual and Quarterly, USA and UK, all indicators\n- `*.*.NGDP_RPCH` - All frequencies and countries, Real GDP Growth\n\nTime filtering is supported via query parameters for IMF.STA datasets.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "data",
                "dataflow",
                ":agency",
                ":dataflow_id",
                "+",
                ":key"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "dimensionAtObservation",
                  "value": "TIME_PERIOD",
                  "description": "Specify which dimension varies at the observation level"
                },
                {
                  "disabled": false,
                  "key": "attributes",
                  "value": "dsd",
                  "description": "Level of attribute detail to include in response"
                },
                {
                  "disabled": false,
                  "key": "measures",
                  "value": "all",
                  "description": "Which measures to return"
                },
                {
                  "disabled": false,
                  "key": "c[TIME_PERIOD]",
                  "value": "<string>",
                  "description": "Time period filter using SDMX comparison operators.\nFormat: ge:YYYY-{freq}N+le:YYYY-{freq}N\nExamples: ge:2010-A1+le:2020-A1 (annual), ge:2010-Q1+le:2020-Q4 (quarterly)\n"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "agency",
                  "description": "(Required) The agency owning the dataflow (e.g., IMF.STA, all)"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "dataflow_id",
                  "description": "(Required) The dataflow identifier (e.g., IFS, GFS, FM, WEO, MFS, BOP)"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "key",
                  "description": "(Required) Dot-separated dimension key with + for multiple values and * for wildcard"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
